{
  "name": "docsite",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "yarn run -T storybook dev -p 6006 --docs",
    "build": "yarn run -T storybook build --docs",
    "lint": "yarn run -T eslint stories .storybook",
    "extract-storybook-llms": "yarn run -T storybook-llms-extractor --distPath storybook-static --summaryBaseUrl https://microsoft.github.io/fluentui-system-icons/"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.46.0",
    "@fluentui/react-icons": "*",
    "@fluentui/react-icons-file-type": "*",
    "@fluentui/react-icons-font-subsetting-webpack-plugin": "*"
  }
}
