{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docsite",
  "projectType": "application",
  "sourceRoot": "packages/docsite/src",
  "tags": ["platform:web"],
  "targets": {
    "dev": {
      "dependsOn": [{ "target": "build", "projects": ["svg-icons"] }]
    },
    "build": {
      "cache": true,
      "inputs": [
        "{projectRoot}/.storybook/**",
        "{projectRoot}/stories/**",
        "{projectRoot}/package.json",
        "{projectRoot}/public/**",
        "{workspaceRoot}/packages/react-icons-file-type/src/common/fileIconTypes.json",
        "{workspaceRoot}/packages/react-icons-file-type/src/common/fileTypeIconMap.json",
        "^default"
      ],
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "lint": {
      "cache": true,
      "inputs": ["{projectRoot}/stories/**", "{projectRoot}/.storybook/**", "{projectRoot}/eslint.config.mjs"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["{projectRoot}/stories/**", "{projectRoot}/vitest.config.ts", "{projectRoot}/package.json", "^default"]
    },
    "extract-storybook-llms": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [{ "externalDependencies": ["@fluentui/storybook-llms-extractor"] }],
      "outputs": ["{projectRoot}/storybook-static/llms", "{projectRoot}/storybook-static/llms.txt"]
    }
  }
}
