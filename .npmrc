# Pin npm to the public npm registry.
#
# Yarn does not read this file — `.yarnrc.yml` carries `npmRegistryServer` for
# installs. This keeps `npm publish` (invoked by `nx release publish`) and any
# ad-hoc `npm` call pointed at the public registry, so a personal proxy/mirror
# `registry=` in ~/.npmrc cannot leak into what we publish or resolve.
registry=https://registry.npmjs.org/
