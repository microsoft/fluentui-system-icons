{
  "compilerOptions": {
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "noEmit": true,
    "module": "esnext",
    "target": "es2020",
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "skipLibCheck": true,
    "strictNullChecks": true,
    "pretty": true
  },
  "include": [
    "icon-name.js",
    "icon-name.test.js",
    "generateFont.js",
    "generateFont.test.js",
    "check-assets.mjs",
    "check-assets.test.mjs"
  ]
}
