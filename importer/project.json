{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "system-icons-processing",
  "projectType": "library",
  "targets": {
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/assets/Checkmark Circle/SVG/ic_fluent_checkmark_circle_24_regular.svg",
        "{workspaceRoot}/fonts/FluentSystemIcons-Regular.json"
      ]
    },
    "deploy:fonts": {
      "cache": true,
      "inputs": ["assets", "fontGenerationToolchain"],
      "outputs": ["{workspaceRoot}/fonts"]
    },
    "check:assets-metadata": {
      "cache": true,
      "inputs": ["assets", "{projectRoot}/check-assets-metadata.mjs"]
    }
  }
}
